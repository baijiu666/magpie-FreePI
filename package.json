{
  "name": "magpie-freepi",
  "version": "0.1.7",
  "description": "magpie-FreePI：把 free-pi（freepi.ai）的免费模型池接进 magpie：自动看广告保活、流式透传、不再需要 Python 反代。",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "AGENTS.md",
    "ERROR-CODES.md",
    "CHANGELOG.md",
    "LICENSE",
    "registry-entry.json",
    "tests",
    "scripts"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-auth",
    "opencode-plugin",
    "provider",
    "freepi",
    "free",
    "免费",
    "deepseek",
    "glm"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "name": "magpie-FreePI",
    "maxConcurrency": 1
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "probe": "node scripts/probe-live.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baijiu666/magpie-FreePI.git"
  },
  "homepage": "https://github.com/baijiu666/magpie-FreePI#readme",
  "bugs": {
    "url": "https://github.com/baijiu666/magpie-FreePI/issues"
  }
}
